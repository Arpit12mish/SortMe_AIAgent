# Copy to .env.local and fill in. Never commit the real file (it's gitignored).
# Load it into your shell before `mvn spring-boot:run`, e.g.:
#   set -a; source .env.local; set +a; mvn spring-boot:run

# --- Database (defaults match the local dev DB created for this project) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sortme_db
DB_USER=sortme_user
DB_PASSWORD=sortme_dev_local_only

# --- App secrets (generate your own; do not reuse these examples) ---
# openssl rand -base64 32
SORTME_SESSION_SIGNING_KEY=
SORTME_OAUTH_STATE_SIGNING_KEY=
SORTME_TOKEN_ENC_KEY=

# The FINAL redirect back into the app once this backend has finished the
# OAuth exchange. Must match app.json's "scheme". This is NOT what you
# register with Google/GitHub -- see SORTME_PUBLIC_BASE_URL below.
SORTME_OAUTH_REDIRECT_URI=sortme://oauth-redirect
# Where this server is reachable from your phone/emulator/browser -- your
# Mac's LAN IP, not localhost, e.g. http://192.168.1.23:8080. Used to build
# the Google Picker page URL AND the OAuth callback URL
# ({this}/api/connections/oauth-callback) that you register in both the
# Google Cloud Console and the GitHub App settings (see setup instructions).
# Google rejects a custom-scheme (sortme://) redirect URI outright, which is
# why the exchange happens at this backend's own HTTPS callback rather than
# directly in the app.
SORTME_PUBLIC_BASE_URL=http://localhost:8080

# --- Google Cloud OAuth client (Web application type) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Project number (not project ID), shown on the Cloud Console home page.
# Optional -- only used for the Google Picker's setAppId().
GOOGLE_CLOUD_PROJECT_NUMBER=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# base64 of the whole downloaded .pem private key file: base64 -i key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
